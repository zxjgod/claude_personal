# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test / coverage artifacts
coverage/
.vitest/

# Local environment
.env
.env.local
.env.*.local

# Provider profiles — contains plaintext API keys (commit providers.json.example instead)
.claude/providers.json

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Session state (runtime artifacts, not source) — anchored at any depth so
# nested sandboxes (e.g. sandbox/.claude/) are covered too.
**/.claude/sessions/
**/.claude/session-runtime/
**/.claude/workflow-runs/
**/.claude/memory/
**/.claude/history/
**/.claude/checkpoints/
**/.claude/memories.jsonl
**/.claude/worktrees/

# Spilled tool results (M30) — runtime artifacts written when output exceeds the cap
.ccr/

# Bundled reference materials (large files)
reference/
*.pdf
claude-code-参考标准/

# Python bytecode
__pycache__/

# Loop iteration scratch space (.review-tmp/ holds throwaway parity probes)
.review-tmp/

# Agent scratch trees. `upgrade-baseline/` is a full frozen copy of the
# project — including its own node_modules — so it must never be committed.
.claude/upgrade-baseline/

# Root-level audit/log artifacts dropped by review & upgrade loops.
# (`*.log` above already covers tsc.log.)
/.upgrade-*
tsc-output.txt