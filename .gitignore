node_modules/
dist/
.env
*.tsbuildinfo

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Test coverage
coverage/

# Local session state (runtime artifacts, not source) — at any depth, so
# nested sandboxes (e.g. sandbox/.claude/) are covered too
**/.claude/sessions/
**/.claude/worktrees/
**/.claude/checkpoints/

# Spilled tool results (M30) — runtime artifacts written when output exceeds the cap
.ccr/

# Provider profiles — contains plaintext API keys (commit providers.json.example instead)
.claude/providers.json

# Bundled reference materials (large files)
reference/
*.pdf

claude-code-参考标准/
tsc-output.txt

# review-process temp artifacts (diffs, notes) — never commit
.review-tmp/
.claude/history/
