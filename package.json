{
  "name": "claude-code-replica",
  "version": "1.0.0",
  "description": "A local AI coding assistant that replicates Claude Code's agentic workflow with third-party LLM APIs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ccr": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "marked": "^12.0.0",
    "openai": "^4.52.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^19.2.7",
    "eslint": "^9.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "claude-code",
    "llm",
    "cli",
    "agent"
  ],
  "license": "MIT"
}
