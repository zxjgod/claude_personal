{
  "name": "claude-code-replica",
  "version": "1.6.1",
  "description": "A local AI coding assistant that replicates Claude Code's agentic workflow with third-party LLM APIs",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "main": "dist/index.js",
  "bin": {
    "ccr": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/pdf-worker.mjs",
    "python/ccr_sdk.py",
    "examples/*.json",
    ".env.example",
    "docs/CHANGELOG.md",
    "docs/快速开始.md",
    "docs/深度使用指南.md",
    "docs/局限性说明.md",
    "docs/loop-management.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check src",
    "smoke": "node scripts/smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:provider": "node scripts/provider-smoke.mjs",
    "docs:sync": "node --import tsx scripts/doc-sync.mjs",
    "prepare": "husky",
    "eval": "node scripts/evaluate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/canvas": "1.0.10",
    "@vscode/ripgrep": "^1.18.0",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "highlight.js": "^11.11.1",
    "ink": "^7.1.0",
    "marked": "^12.0.0",
    "openai": "^4.52.0",
    "pdfjs-dist": "6.4.299",
    "picomatch": "^4.0.7",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^20.12.0",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.0.8",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "claude-code",
    "llm",
    "cli",
    "agent"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,mjs}": "biome check --write --no-errors-on-unmatched"
  }
}
