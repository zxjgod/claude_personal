# ============================================================
# Claude Code Replica — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Supported: anthropic | openai | deepseek | qwen | moonshot | zhipu | custom
LLM_PROVIDER=anthropic

# --- API Key ---
LLM_API_KEY=sk-your-api-key-here

# --- Model ---
# Leave empty to use the provider's default model
# openai: gpt-4o | anthropic: claude-opus-4-8 | deepseek: deepseek-chat | qwen: qwen-plus
LLM_MODEL=

# --- Base URL (for proxies or non-standard endpoints) ---
# Leave empty for default based on provider
# LLM_BASE_URL=https://api.openai.com/v1

# --- Model Parameters ---
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# --- Permission Mode ---
# default | acceptEdits | bypassPermissions | plan
PERMISSION_MODE=default

# --- Workspace ---
# Leave empty to use current directory
# WORKSPACE_ROOT=/path/to/your/project
