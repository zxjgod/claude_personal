# ============================================================
# Claude Code Replica — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Supported: anthropic | openai | deepseek | qwen | moonshot | zhipu | custom
LLM_PROVIDER=anthropic

# --- API Key ---
LLM_API_KEY=sk-your-api-key-here

# --- Model ---
# Leave empty to use the provider's default model
# openai: gpt-4o | anthropic: claude-opus-4-8 | deepseek: deepseek-chat | qwen: qwen-plus
LLM_MODEL=

# --- Base URL (for proxies or non-standard endpoints) ---
# Leave empty for default based on provider
# LLM_BASE_URL=https://api.openai.com/v1

# --- Multiple endpoints (relays / domestic platforms) ---
# To keep several presets and hot-swap between them in-session (no restart),
# copy .claude/providers.json.example to .claude/providers.json and use
# /provider (arrow-key picker) or /provider <name>. That file overrides the
# single .env config above only when you switch to one of its profiles.

# --- Model Parameters ---
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# --- Permission Mode ---
# default | acceptEdits | bypassPermissions | plan
PERMISSION_MODE=default

# --- Workspace ---
# Leave empty to use current directory
# WORKSPACE_ROOT=/path/to/your/project

# ============================================================
# Advanced / optional runtime switches (all commented out by default;
# most also have an equivalent CLI flag). Read by src/cli.ts and friends.
# ============================================================

# --- Cloud gateway (Bedrock / Vertex) ---
# Routes OpenAI-compatible traffic to a gateway instead of a plain base URL.
# LLM_GATEWAY=bedrock|vertex
# LLM_GATEWAY_REGION=us-east-1
# LLM_GATEWAY_PROJECT=your-gcp-project        # vertex only

# --- Output / TTY ---
# CCR_VERBOSE=1            # verbose output (--verbose)
# CCR_QUIET=1              # quiet mode (--quiet)
# SHOW_TOKENS=1            # show live token count (--show-tokens)
# CCR_NO_TUI=1             # force line-based REPL even on a TTY (--no-tui)
# CCR_FULLSCREEN=1         # full-screen TUI layout (--fullscreen)
# CCR_REDUCED_MOTION=1     # reduce spinner animation (accessibility)
# CCR_LANGUAGE=zh|en       # force UI language (default: auto-detect from LANG/LC_ALL)

# --- Behavior / tuning ---
# CCR_SPECULATION=0        # disable speculative prefetch (--no-speculation)
# CCR_PERM_CLASSIFIER=1    # enable LLM risk classifier in permission checks
# CCR_MICROCOMPACT_ENABLED=1
# CCR_MICROCOMPACT_GAP_MINUTES=10
# CCR_MICROCOMPACT_KEEP_RECENT=20
# CLAUDE_CODE_SIMPLE=1     # simplified system prompt
# CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=10   # tool concurrency cap
# TASK_MAX_CONCURRENCY=3   # sub-agent task concurrency cap
# CCR_USER_SKILLS_DIR=/path/to/skills        # override user skills directory

# --- Debug / telemetry ---
# DEBUG_STREAM=1           # stream debug logging
# DEBUG_PERMISSIONS=1      # permission decision-chain logging
# CCR_TELEMETRY=1          # local telemetry (default OFF, privacy by default)
